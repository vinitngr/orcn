{
  "version": "v2",
  "job_name": "qwen2-7b-production",
  "type": "container",

  "meta": {
    "trigger": "dashboard",
    "description": "Production Qwen2 Deployment",
    "system_requirements": {
      "min_vram_gb": 24,
      "min_cores": 4,
      "min_ram_gb": 16,
      "cuda_version": "12.1",
      "arch": "amd64",
      "gpu_model": "RTX 4090"
    }
  },

  "volumes": [
    {
      "name": "model-cache",
      "type": "persistent",
      "size_gb": 50
    }
  ],

  "containers": [
    {
      "id": "ai-master",
      "args": {
        "image": "vllm/vllm-openai:latest",
        "gpu": true,
        "cmd": [
          "--model", "Qwen/Qwen2-7B-Instruct",
          "--enforce-eager",
          "--port", "8000"
        ],
        "env": {
          "HF_TOKEN": "xxxx"
        },
        "volume_mounts": [
          {
            "volume_name": "model-cache",
            "mount_path": "/root/.cache/huggingface"
          }
        ],
        "expose": [
          {
            "port": 8000,
            "protocol": "http",
            "is_public": true,
            "health_check": {
              "path": "/v1/models",
              "expected_status": 200,
              "timeout_seconds": 10
            }
          }
        ]
      }
    },
    {
      "id": "orcn-node-agent",
      "args": {
        "image": "orcn/node-agent:latest",
        "gpu": false,
        "cmd": [
          "--mode", "sidecar"
        ],
        "env": {
          "CONTROLLER_URL": "https://api.orcn.io/v1/internal/telemetry",
          "NODE_ID": "node-77x9a",
          "DEPLOYMENT_ID": "dep-1234abcd",
          "AUTH_TOKEN": "jwt_secret_token_generated_by_orchestrator",
          "MONITOR_GPU": "true",
          "LOG_LEVEL": "debug"
        },
        "volume_mounts": [],
        "expose": [
          {
            "port": 9090,
            "protocol": "http",
            "is_public": false
          }
        ]
      }
    }
  ]
}
